{
  "expo": {
    "name": "ChiefStaff",
    "slug": "chiefstaff",
    "version": "0.1.0",
    "scheme": "chiefstaff",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kabbout.chiefstaff",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kabbout.chiefstaff",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000",
      "router": {},
      "eas": {
        "projectId": "9a146b88-5535-46f3-88b6-2b921f777f5f"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "akabbout",
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/9a146b88-5535-46f3-88b6-2b921f777f5f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
