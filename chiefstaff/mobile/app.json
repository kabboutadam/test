{
  "expo": {
    "name": "ChiefStaff",
    "slug": "chiefstaff",
    "version": "0.1.0",
    "scheme": "chiefstaff",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adamkabbout.chiefstaff",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.adamkabbout.chiefstaff",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:3000"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
