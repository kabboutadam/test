{
  "expo": {
    "name": "BusMapp",
    "slug": "busmapp",
    "version": "0.3.1",
    "orientation": "portrait",
    "scheme": "busmapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/00f7a40f-842a-4d37-a330-95d445d20e77"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B6E4F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.busmapp.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.busmapp.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B6E4F"
      },
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BusMapp shares the bus's live location with parents while you drive the route \u2014 including with the app in the background.",
          "locationAlwaysAndWhenInUsePermission": "BusMapp shares the bus's live location with parents while you drive the route \u2014 including with the app in the background.",
          "locationAlwaysPermission": "BusMapp shares the bus's live location with parents while you drive the route \u2014 including with the app in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "useBackend": true,
      "apiBaseUrl": "https://busmapp-api.onrender.com",
      "eas": {
        "projectId": "00f7a40f-842a-4d37-a330-95d445d20e77"
      }
    }
  }
}
