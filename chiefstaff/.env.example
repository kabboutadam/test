# Postgres. `docker compose up -d` starts one matching this URL.
DATABASE_URL="postgresql://chief:chief@localhost:5432/chiefstaff?schema=public"

# Anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# Google OAuth client (type: Web application).
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# 32+ random chars. Signs the session cookie. `openssl rand -base64 32`
SESSION_SECRET=""

# Set to the seeded demo user's email to browse the app without connecting Google.
DEMO_USER_EMAIL="dana@northwind.example"
