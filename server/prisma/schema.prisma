// BusMapp data model. Postgres in production; see docker-compose.yml for a local
// instance and .env.example for DATABASE_URL. The server only uses this when
// USE_PRISMA=true — otherwise it runs on in-memory seed data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id        String     @id
  name      String
  lat       Float
  lng       Float
  routes    Route[]
  operators Operator[]
}

model Operator {
  id       String @id
  name     String
  phone    String @unique
  school   School @relation(fields: [schoolId], references: [id])
  schoolId String
}

model Route {
  id       String  @id
  name     String
  school   School  @relation(fields: [schoolId], references: [id])
  schoolId String
  stops    Stop[]
  buses    Bus[]
  children Child[]
}

model Stop {
  id                   String  @id
  name                 String
  order                Int
  lat                  Float
  lng                  Float
  travelMinutesFromPrev Int
  scheduledTime        String
  route                Route   @relation(fields: [routeId], references: [id])
  routeId              String
  children             Child[]

  @@index([routeId, order])
}

model Bus {
  id          String @id
  plateNumber String
  driverName  String
  driverPhone String
  capacity    Int
  route       Route  @relation(fields: [routeId], references: [id])
  routeId     String
}

model Parent {
  id           String        @id
  name         String
  email        String
  phone        String        @unique
  children     Child[]
  subscription Subscription?
}

model Child {
  id       String @id
  name     String
  grade    String
  color    String
  parent   Parent @relation(fields: [parentId], references: [id])
  parentId String
  route    Route  @relation(fields: [routeId], references: [id])
  routeId  String
  stop     Stop   @relation(fields: [stopId], references: [id])
  stopId   String
}

model Subscription {
  id       String  @id @default(cuid())
  parent   Parent  @relation(fields: [parentId], references: [id])
  parentId String  @unique
  status   String // 'trial' | 'active' | 'expired' | 'none'
  plan     String? // 'monthly' | 'yearly'
  renewsAt String?
}
