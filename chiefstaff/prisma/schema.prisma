// ChiefStaff data model.
//
// The shape follows the product thesis: signals come in from connected
// sources, get resolved against people, and are turned into exactly two
// things an executive acts on — Decisions (needs you now) and Loops
// (you're waiting on someone). Briefs are a rendering of both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The executive. One row per person the product serves.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String?
  company   String?
  timezone  String   @default("UTC")
  briefHour Int      @default(6)
  createdAt DateTime @default(now())

  connections Connection[]
  people      Person[]
  signals     Signal[]
  decisions   Decision[]
  loops       Loop[]
  briefs      Brief[]
  linkCodes   LinkCode[]
  apiTokens   ApiToken[]
  devices     Device[]
  metrics     Metric[]
  movements   Movement[]
  records     DecisionRecord[]
  preps       MeetingPrep[]
}

/// A connected source account (today: Google Workspace).
/// Tokens here are the executive's own — everything we read is read as them,
/// so source-side ACLs are inherited for free. See docs/ARCHITECTURE.md.
model Connection {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  accountEmail String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String
  /// Gmail historyId for incremental sync; null forces a bounded backfill.
  cursor       String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, accountEmail])
}

/// A human the executive deals with. Built by entity resolution over signals,
/// so importance is observed rather than declared.
model Person {
  id           String    @id @default(cuid())
  userId       String
  email        String
  name         String?
  org          String?
  /// report | peer | board | investor | customer | vendor | external | unknown
  relationship String    @default("unknown")
  /// 0-100, derived from interaction volume, recency and direction.
  importance   Int       @default(0)
  interactions Int       @default(0)
  lastInbound  DateTime?
  lastOutbound DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  signals   Signal[]
  decisions Decision[]   @relation("DecisionPerson")
  delegated Decision[]   @relation("DecisionDelegate")
  loops     Loop[]
  metrics   Metric[]
  owned     DecisionRecord[] @relation("RecordOwner")
  decided   DecisionRecord[] @relation("RecordDecider")
  preps     MeetingPrep[]

  @@unique([userId, email])
  @@index([userId, importance])
}

/// One normalized thing that happened, from any source.
model Signal {
  id         String   @id @default(cuid())
  userId     String
  /// gmail | gcal
  source     String
  /// Stable id in the source system. Makes sync idempotent.
  externalId String
  /// email | meeting
  kind       String
  /// Groups related signals (Gmail threadId, Calendar recurring event id).
  threadKey  String?
  subject    String
  snippet    String   @db.Text
  body       String?  @db.Text
  /// Deep link back into the source. Every generated claim cites one of these.
  url        String?
  occurredAt DateTime
  fromId     String?
  /// Emails of everyone on the signal, executive included.
  participants String[]
  raw        Json?
  /// Null until the triage pass has looked at it.
  processedAt DateTime?
  createdAt  DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  from      Person?    @relation(fields: [fromId], references: [id], onDelete: SetNull)
  decisions Decision[]
  loops     Loop[]

  @@unique([userId, source, externalId])
  @@index([userId, processedAt])
  @@index([userId, occurredAt])
}

/// Something that needs the executive. The core surface of the product.
model Decision {
  id       String @id @default(cuid())
  userId   String
  signalId String?
  personId String?

  title    String
  /// One sentence on why this reached the executive at all.
  why      String @db.Text
  /// approval | reply | escalation | scheduling | review
  category String
  /// 0 = whenever, 1 = this week, 2 = today, 3 = now.
  urgency  Int    @default(1)

  /// Pre-drafted response. Never sent without explicit approval.
  draft     String? @db.Text
  draftKind String?

  /// open | approved | dismissed | done | delegated | snoozed
  status     String    @default("open")
  dueAt      DateTime?
  /// Hidden from the inbox and brief until this passes; then reopened.
  snoozedUntil DateTime?
  /// Delegating creates a Loop: the executive is now waiting on this person.
  delegatedToId String?
  /// [{ label, url }] pointing back at source material.
  citations  Json      @default("[]")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal      Signal? @relation(fields: [signalId], references: [id], onDelete: SetNull)
  person      Person? @relation("DecisionPerson", fields: [personId], references: [id], onDelete: SetNull)
  delegatedTo Person? @relation("DecisionDelegate", fields: [delegatedToId], references: [id], onDelete: SetNull)
  records     DecisionRecord[]

  @@index([userId, status, urgency])
}

/// An ask the executive made that hasn't come back. The feature nobody ships.
model Loop {
  id       String @id @default(cuid())
  userId   String
  personId String?
  signalId String?

  ask       String    @db.Text
  askedAt   DateTime
  /// When the executive said they needed it, if they said.
  dueAt     DateTime?
  /// owed_to_me: they promised the executive. owed_by_me: the executive
  /// promised them. Both matter in a 1:1; only the first is "waiting on".
  direction String    @default("owed_to_me")
  /// waiting | answered | dropped
  status    String    @default("waiting")
  lastNudge DateTime?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  signal Signal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

/// A generated daily brief, kept so we can diff "what changed since yesterday".
/// forDate is the executive's LOCAL calendar day, not the UTC one.
model Brief {
  id        String   @id @default(cuid())
  userId    String
  forDate   DateTime @db.Date
  markdown  String   @db.Text
  model     String
  createdAt DateTime @default(now())
  /// Set once the brief has actually reached the executive. The morning run is
  /// idempotent on this, so a retry never sends a second copy.
  deliveredAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, forDate])
}

/// A short-lived code shown on the web so a phone can link itself. Same
/// pattern as linking a TV: the executive never types a password on a phone,
/// and the phone never touches Google OAuth.
model LinkCode {
  id        String    @id @default(cuid())
  userId    String
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A long-lived bearer token for one device. Only the hash is stored; the
/// token itself is shown exactly once, at link time.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  label      String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A phone that wants the brief. Expo push tokens are opaque and per-install.
model Device {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      String
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A number the executive watches. Rows come from a spreadsheet import today
/// and from QuickBooks / Toast / Gusto connectors tomorrow — all feed the same
/// shape, so "what moved" never knows where a number came from.
model Metric {
  id        String  @id @default(cuid())
  userId    String
  /// Stable key within a user, e.g. "labor_pct". Segment makes it per-location.
  key       String
  name      String
  unit      String  @default("")
  /// A location, business line or team. Empty for company-wide.
  segment   String  @default("")
  /// up | down | neutral — which way is good news.
  goodWhen  String  @default("neutral")
  /// Standard deviations from the metric's own history before it "moved".
  /// Tunable per metric, per the spec; 2.0 is deliberately conservative.
  sensitivity Float @default(2)
  /// Who owns this number. Feeds "who to talk to" and 1:1 prep.
  ownerId   String?
  source    String  @default("csv")
  muted     Boolean @default(false)
  createdAt DateTime @default(now())

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner     Person?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  points    MetricPoint[]
  movements Movement[]
  records   DecisionRecord[]

  @@unique([userId, key, segment])
}

model MetricPoint {
  id          String   @id @default(cuid())
  metricId    String
  periodStart DateTime @db.Date
  value       Float
  source      String   @default("csv")
  createdAt   DateTime @default(now())

  metric Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, periodStart])
  @@index([metricId, periodStart])
}

/// A metric that left its own normal range. One per metric per period, so a
/// re-run never duplicates. "Not useful" from the executive raises that
/// metric's sensitivity — the tuning loop the spec asks for.
model Movement {
  id          String   @id @default(cuid())
  userId      String
  metricId    String
  periodStart DateTime @db.Date
  value       Float
  baseline    Float
  /// Signed standard deviations from baseline.
  deviation   Float
  /// The sentence that goes in the brief. Plain, with the comparison basis.
  sentence    String   @db.Text
  /// open | useful | not_useful
  status      String   @default("open")
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, periodStart])
  @@index([userId, status, createdAt])
}

/// The Decision Log (spec 5.2): a decision recorded with the expectation
/// behind it, so the loop can be closed on the review date.
model DecisionRecord {
  id        String   @id @default(cuid())
  userId    String
  title     String
  rationale String   @db.Text
  decidedAt DateTime @default(now())
  deciderId String?
  ownerId   String?
  /// hiring | spend | pricing | ops | people | strategy | other
  category  String   @default("other")
  /// The expected outcome, as a measurable claim where possible.
  expected  String   @db.Text
  /// When expectation is measurable: the metric and value it should reach.
  metricId      String?
  expectedValue Float?
  reviewAt  DateTime
  /// Set when the review lands in the inbox, so it lands once.
  reviewRequestedAt DateTime?
  /// open | hit | miss | mixed | dropped
  status      String    @default("open")
  outcome     String?   @db.Text
  reviewedAt  DateTime?
  /// The inbox item this was logged from, if any.
  fromDecisionId String?
  createdAt   DateTime  @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  decider Person?   @relation("RecordDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  owner   Person?   @relation("RecordOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  metric  Metric?   @relation(fields: [metricId], references: [id], onDelete: SetNull)
  from    Decision? @relation(fields: [fromDecisionId], references: [id], onDelete: SetNull)

  @@index([userId, status, reviewAt])
}

/// Prep for one meeting (spec 5.4), generated ahead of it. Stored so the
/// brief, the web and the phone all show the same thing.
model MeetingPrep {
  id          String   @id @default(cuid())
  userId      String
  /// The calendar Signal this is for.
  signalId    String   @unique
  personId    String?
  startsAt    DateTime
  title       String
  /// Rendered sections: [{ heading, lines: string[] }]
  sections    Json
  generatedAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
}
