# Copy to .env and adjust.

# Server
PORT=3000
NODE_ENV=development

# Auth — change this in production.
JWT_SECRET=dev-secret-change-me

# Platform owners (super-admins). Comma-separated phone numbers that can create
# schools and provision each school's login. Keep this to your own number(s).
SUPERADMIN_PHONES=+961 3 000 000

# SMS for OTP. 'console' (default) just logs the code and returns it in the
# request response for local testing. Set 'twilio' + the Twilio vars to send
# real texts (required so TestFlight testers can receive codes).
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1XXXXXXXXXX

# Data source. Leave USE_PRISMA unset (or not "true") to run on in-memory seed
# data with zero infrastructure. Set to "true" to use Postgres via Prisma.
USE_PRISMA=false

# Postgres connection (only needed when USE_PRISMA=true). Matches docker-compose.
DATABASE_URL=postgresql://busmapp:busmapp@localhost:5432/busmapp?schema=public
